# Copy to deploy/.env for Docker Compose. Keep the real file out of git.
# The workdir is mounted at the same absolute path inside the container.
OPENCODE_WORKDIR=/home/you/projects

# Generate with: openssl rand -base64 48
AUTH_TOKEN=replace-with-at-least-32-random-characters

# OpenCode runs on the host. The bridge only accepts loopback URLs.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=replace-with-the-opencode-password

# Optional: browser origins allowed to call the bridge directly.
# CORS_ORIGINS=https://mobile.example.com
LOG_LEVEL=info
PUSH_ENABLED=1
