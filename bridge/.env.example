# Bridge configuration. Copy to .env and set a unique AUTH_TOKEN.
PORT=8787
HOST=127.0.0.1
AUTH_TOKEN=replace-with-at-least-32-random-characters

# Optional. When omitted, the bridge discovers the running OpenCode service.
# OPENCODE_URL=http://127.0.0.1:49374
# OPENCODE_PASSWORD=

# Browser origins allowed to call the bridge, as exact scheme://host:port
# values. Leave empty to disable cross-origin browser access. Do not use "*".
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Comma-separated absolute paths. Keep this narrow.
ALLOWED_WORKDIRS=/path/to/your/projects

MAX_UPLOAD_MB=25
MAX_UPLOAD_TOTAL_MB=100
MAX_FILES_PER_MESSAGE=10

# Optional. Comma-separated MIME types and extensions.
# ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,text/plain,.ts,.tsx,.js,.md

DATA_DIR=./data
BAN_AFTER=10
BAN_MINUTES=15
RATE_LIMIT_PER_MINUTE=180
LOG_LEVEL=info

# Set to 0 to disable Expo push registration.
PUSH_ENABLED=1
