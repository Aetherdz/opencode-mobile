{
  "expo": {
    "name": "OpenCode Mobile",
    "slug": "opencode-mobile",
    "version": "1.0.0-beta.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opencode-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.zaikabdou1.opencodemobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow OpenCode Mobile to attach photos to your messages.",
        "NSCameraUsageDescription": "Allow OpenCode Mobile to take a photo to attach to a message.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zaikabdou1.opencodemobile",
      "versionCode": 6,
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenCode Mobile to attach photos to your messages.",
          "cameraPermission": "Allow OpenCode Mobile to take a photo to attach to a message."
        }
      ],
      "expo-document-picker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
