{
  "expo": {
    "name": "OpenCode Mobile",
    "slug": "opencode-mobile",
    "version": "1.0.0-beta.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "opencode-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.aetherdz.opencodemobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow OpenCode Mobile to attach photos to your messages.",
        "NSCameraUsageDescription": "Allow OpenCode Mobile to take a photo to attach to a message.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      },
      "buildNumber": "9"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aetherdz.opencodemobile",
      "versionCode": 14
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "OpenCode Mobile",
      "shortName": "OC Mobile",
      "description": "An unofficial mobile and web client for your local OpenCode service.",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OpenCode Mobile to scan a bridge connection QR code.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenCode Mobile to attach photos to your messages.",
          "cameraPermission": "Allow OpenCode Mobile to take a photo to attach to a message."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
